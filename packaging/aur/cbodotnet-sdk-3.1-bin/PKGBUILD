# Maintainer: .NET Dev contributors (https://dotnetdev.kr/)
# Qualified prebuilt SDK; distribution.json records corresponding source/evidence.
pkgname=cbodotnet-sdk-3.1-bin
pkgver=3.1.426
pkgrel=1
pkgdesc='Community Build of .NET (built by .NET Dev) SDK'
arch=('x86_64')
url='https://dotnetdev.kr/cbodotnet/'
license=('MIT' 'LicenseRef-Dotnet-ThirdPartyNotices')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib' 'krb5' 'ca-certificates' 'icu' 'openssl' 'curl' 'libnghttp2' 'cbodotnet-compat-rocky9=2026.11.4-1' 'cbodotnet-compat-curl-rocky8=2026.11.4-1' 'cbodotnet-host>=1.0.0')
makedepends=('python')
options=('!strip' '!debug' '!lto' '!zipman' '!purge' 'docs' 'libtool' 'staticlibs' 'emptydirs')
source=('cbodotnet-3.1' 'distribution.json' 'verify-source.py' 'release-manifest.json::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-3.1.426/release-manifest.json' 'SHA256SUMS::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-3.1.426/SHA256SUMS')
sha256sums=('2926db594d3945c4192f7c6766f4b20c0009bc019449f0305a6d46313f266fcb' '4d63b7690181da9263639383c8db2eff3e3b6558232b9c8b620173f200e8aba8' 'ce7d7936e3407e22a6934a8f1effecb7be8670ddf1a76559e47319e3f3dabb47' '70049972a8781c309fae40e5f68d74847d0a9a590d36de4f25ecc2ad50578b09' '9be0812b27d96321f531a8b1a0694969ca898974b88c2582582c22f0e00f3c7e')
source_x86_64=('https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-3.1.426/cbodotnet-sdk-3.1.426-linux-x64.tar.gz')
sha256sums_x86_64=('7d0b197181bc10ba7ecffe6f820771560db6330004f44d314e7e4d80db2e89bd')
noextract=('cbodotnet-sdk-3.1.426-linux-x64.tar.gz')

prepare() {
  python "$srcdir/verify-source.py" --policy "$srcdir/distribution.json" \
    --manifest "$srcdir/release-manifest.json" --checksums "$srcdir/SHA256SUMS" \
    --archive "$srcdir/cbodotnet-sdk-3.1.426-linux-x64.tar.gz" --destination "$srcdir/sdk-3.1.426"
}

package() {
  install -dm755 "$pkgdir/opt/cbodotnet/3.1"
  cp -a --no-preserve=ownership "$srcdir/sdk-3.1.426/." "$pkgdir/opt/cbodotnet/3.1/"

  install -Dm755 "$srcdir/cbodotnet-3.1" "$pkgdir/usr/bin/cbodotnet-3.1"
  install -Dm644 "$srcdir/distribution.json" "$pkgdir/usr/share/doc/$pkgname/distribution.json"
  install -Dm644 "$srcdir/sdk-3.1.426/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 "$srcdir/sdk-3.1.426/ThirdPartyNotices.txt" "$pkgdir/usr/share/licenses/$pkgname/ThirdPartyNotices.txt"
}
