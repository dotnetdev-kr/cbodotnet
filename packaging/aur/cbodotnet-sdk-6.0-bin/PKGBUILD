# Maintainer: .NET Dev contributors (https://dotnetdev.kr/)
# Qualified prebuilt SDK; distribution.json records corresponding source/evidence.
pkgname=cbodotnet-sdk-6.0-bin
pkgver=6.0.136
pkgrel=1
pkgdesc='Community Build of .NET (built by .NET Dev) SDK'
arch=('x86_64')
url='https://dotnetdev.kr/cbodotnet/'
license=('MIT' 'LicenseRef-Dotnet-ThirdPartyNotices')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib' 'krb5' 'ca-certificates' 'icu' 'openssl' 'cbodotnet-host>=1.0.0')
makedepends=('python')
options=('!strip' '!debug' '!lto' '!zipman' '!purge' 'docs' 'libtool' 'staticlibs' 'emptydirs')
source=('cbodotnet-6.0' 'distribution.json' 'verify-source.py' 'release-manifest.json::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-6.0.136/release-manifest.json' 'SHA256SUMS::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-6.0.136/SHA256SUMS')
sha256sums=('f6451c789bf5a43cbb45cfec81cd75e0b2679ff673300230c3a928777bf091df' 'c66e0a7c05a3326d42f882e619155b87b691d1c9d7af417fc54a1743252b77b7' 'ce7d7936e3407e22a6934a8f1effecb7be8670ddf1a76559e47319e3f3dabb47' '5e9404de6bde02aed938951182da03380ae37f7b506a8fbf46a186d4bca484fd' '1bfebe035c4c571758ec4a5123c1e3902bd0c45839b717b5c4c12bdc2f491aa5')
source_x86_64=('https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-6.0.136/cbodotnet-sdk-6.0.136-linux-x64.tar.gz')
sha256sums_x86_64=('34eca0b48c7f64a048ea640437db063136d982b2e0209876b1ceb9b0c555f146')
noextract=('cbodotnet-sdk-6.0.136-linux-x64.tar.gz')

prepare() {
  python "$srcdir/verify-source.py" --policy "$srcdir/distribution.json" \
    --manifest "$srcdir/release-manifest.json" --checksums "$srcdir/SHA256SUMS" \
    --archive "$srcdir/cbodotnet-sdk-6.0.136-linux-x64.tar.gz" --destination "$srcdir/sdk-6.0.136"
}

package() {
  install -dm755 "$pkgdir/opt/cbodotnet/6.0"
  cp -a --no-preserve=ownership "$srcdir/sdk-6.0.136/." "$pkgdir/opt/cbodotnet/6.0/"

  install -Dm755 "$srcdir/cbodotnet-6.0" "$pkgdir/usr/bin/cbodotnet-6.0"
  install -Dm644 "$srcdir/distribution.json" "$pkgdir/usr/share/doc/$pkgname/distribution.json"
  install -Dm644 "$srcdir/sdk-6.0.136/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 "$srcdir/sdk-6.0.136/ThirdPartyNotices.txt" "$pkgdir/usr/share/licenses/$pkgname/ThirdPartyNotices.txt"
}
