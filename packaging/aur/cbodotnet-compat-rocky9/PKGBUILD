# Separate provider; no SDK binaries are included or rebuilt.
pkgname=cbodotnet-compat-rocky9
pkgver=2026.11.4
pkgrel=1
pkgdesc='Separately managed Rocky-origin OpenSSL 1.1 and ICU 67 for Community Build legacy SDKs'
arch=('x86_64')
url='https://dotnetdev.kr/cbodotnet/'
license=('LicenseRef-OpenSSL-SSLeay' 'Apache-2.0' 'Unicode-DFS-2016' 'BSD-2-Clause' 'BSD-3-Clause' 'LicenseRef-Fedora-Public-Domain')
depends=('glibc>=2.34' 'libgcc' 'libstdc++' 'zlib' 'ca-certificates')
makedepends=('rpm-tools' 'gnupg')
options=('!strip' '!debug' '!lto')
source=(
  "https://dl.rockylinux.org/pub/rocky/9/AppStream/x86_64/os/Packages/c/compat-openssl11-1.1.1k-5.el9_8.6.x86_64.rpm"
  "https://dl.rockylinux.org/pub/rocky/9/BaseOS/x86_64/os/Packages/l/libicu-67.1-10.el9_6.x86_64.rpm"
  "https://dl.rockylinux.org/pub/rocky/9/AppStream/source/tree/Packages/c/compat-openssl11-1.1.1k-5.el9_8.6.src.rpm"
  "https://dl.rockylinux.org/pub/rocky/9/BaseOS/source/tree/Packages/i/icu-67.1-10.el9_6.src.rpm"
  "https://dl.rockylinux.org/pub/rocky/RPM-GPG-KEY-Rocky-9"
  'openssl.cnf' 'NOTICE.txt' 'provider-manifest.json')
sha256sums=('d0a9dea703933955dc7872aa20f49841cea408ea5a5eb9546956c55e24a4afad' '14c314868326269c62498d149399888ce3c819efddaba79d50d2a5ac90c29b87' '5db77898fe9448fbcd30e5c190227dfa37f6d8391777e72b23f1265b911daa72' 'f54906b1d9469a82da2fa1684f76b7193b7984fe28b21a9cd8f05025b2844420' '3a66e521e7a4abac9768d889c7cd60a8250f59512b275cf576c8a10ff34624c1'
  '650bc90ef37e46f7b5c86f969a9f714e342494bc8471db213058fea2816ad37f' 'e21192e53847a21ca848dd47434b10b55dc9fd79337cce01b4b48b4b8a8937dd' '19a1f16972f653df3f0d32a0ac483689fc3cbd8486eb197030d2446754d4e430')
noextract=(compat-openssl11-1.1.1k-5.el9_8.6.x86_64.rpm libicu-67.1-10.el9_6.x86_64.rpm compat-openssl11-1.1.1k-5.el9_8.6.src.rpm icu-67.1-10.el9_6.src.rpm RPM-GPG-KEY-Rocky-9)
prepare() {
  local fpr
  fpr=$(gpg --batch --with-colons --show-keys RPM-GPG-KEY-Rocky-9 | awk -F: '$1=="pub"{primary=1;next} primary&&$1=="fpr"{print $10;primary=0}')
  [[ "$fpr" == '21CB256AE16FC54C6E652949702D426D350D275D' ]]
  mkdir -p "$srcdir/rpmdb"
  rpmdb --dbpath "$srcdir/rpmdb" --initdb
  rpmkeys --dbpath "$srcdir/rpmdb" --import RPM-GPG-KEY-Rocky-9
  local rpm
  for rpm in *.rpm; do rpmkeys --dbpath "$srcdir/rpmdb" --checksig "$rpm"; done
  mkdir -p compat-openssl11 libicu
  bsdtar -xf compat-openssl11-1.1.1k-5.el9_8.6.x86_64.rpm -C compat-openssl11
  bsdtar -xf libicu-67.1-10.el9_6.x86_64.rpm -C libicu
}
package() {
  local dest="$pkgdir/usr/lib/cbodotnet/compat/rocky9"
  mkdir -p "$dest/lib"
  install -Dm755 "compat-openssl11/usr/lib64/libcrypto.so.1.1.1k" "$dest/lib/libcrypto.so.1.1.1k"
  ln -s libcrypto.so.1.1.1k "$dest/lib/libcrypto.so.1.1"
  install -Dm755 "compat-openssl11/usr/lib64/libssl.so.1.1.1k" "$dest/lib/libssl.so.1.1.1k"
  ln -s libssl.so.1.1.1k "$dest/lib/libssl.so.1.1"
  install -Dm644 "compat-openssl11/usr/share/licenses/compat-openssl11/LICENSE" "$dest/LICENSE.openssl.txt"
  install -Dm755 "libicu/usr/lib64/libicudata.so.67.1" "$dest/lib/libicudata.so.67.1"
  ln -s libicudata.so.67.1 "$dest/lib/libicudata.so.67"
  install -Dm755 "libicu/usr/lib64/libicui18n.so.67.1" "$dest/lib/libicui18n.so.67.1"
  ln -s libicui18n.so.67.1 "$dest/lib/libicui18n.so.67"
  install -Dm755 "libicu/usr/lib64/libicuuc.so.67.1" "$dest/lib/libicuuc.so.67.1"
  ln -s libicuuc.so.67.1 "$dest/lib/libicuuc.so.67"
  install -Dm644 "libicu/usr/share/licenses/libicu/LICENSE" "$dest/LICENSE.icu.txt"
  install -m644 openssl.cnf NOTICE.txt provider-manifest.json "$dest/"
}
