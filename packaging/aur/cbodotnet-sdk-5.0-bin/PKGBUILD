# Maintainer: .NET Dev contributors (https://dotnetdev.kr/)
# Qualified prebuilt SDK; distribution.json records corresponding source/evidence.
pkgname=cbodotnet-sdk-5.0-bin
pkgver=5.0.214
pkgrel=1
pkgdesc='Community Build of .NET (built by .NET Dev) SDK'
arch=('x86_64')
url='https://dotnetdev.kr/cbodotnet/'
license=('MIT' 'LicenseRef-Dotnet-ThirdPartyNotices')
depends=('glibc' 'libgcc' 'libstdc++' 'zlib' 'krb5' 'ca-certificates' 'icu' 'openssl' 'cbodotnet-compat-rocky9=2026.11.4-1' 'cbodotnet-host>=1.0.0')
makedepends=('python')
options=('!strip' '!debug' '!lto' '!zipman' '!purge' 'docs' 'libtool' 'staticlibs' 'emptydirs')
source=('cbodotnet-5.0' 'distribution.json' 'verify-source.py' 'release-manifest.json::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-5.0.214/release-manifest.json' 'SHA256SUMS::https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-5.0.214/SHA256SUMS')
sha256sums=('8f002df45e54d345cae2cde665b55ede9ef303b761407a1a04e7fa946e4be085' '4f2173c290ac2d040b95502b9f504d60dcdff0ed9073c5a9c827a189c6ad4997' 'ce7d7936e3407e22a6934a8f1effecb7be8670ddf1a76559e47319e3f3dabb47' '2a98666b057b5e8c2c8ef149c5ebca7528c2048d7cc1aa38611d48d0d104c67f' 'c979d6681d237d6114ed7d87e3e575cc82fe3c672caabf39bd13f8940a136574')
source_x86_64=('https://github.com/dotnetdev-kr/cbodotnet/releases/download/sdk-5.0.214/cbodotnet-sdk-5.0.214-linux-x64.tar.gz')
sha256sums_x86_64=('d79782992d27e55d7561cd190411b9f6ad3160bb3a91a71064bc7efdc0470d8e')
noextract=('cbodotnet-sdk-5.0.214-linux-x64.tar.gz')

prepare() {
  python "$srcdir/verify-source.py" --policy "$srcdir/distribution.json" \
    --manifest "$srcdir/release-manifest.json" --checksums "$srcdir/SHA256SUMS" \
    --archive "$srcdir/cbodotnet-sdk-5.0.214-linux-x64.tar.gz" --destination "$srcdir/sdk-5.0.214"
}

package() {
  install -dm755 "$pkgdir/opt/cbodotnet/5.0"
  cp -a --no-preserve=ownership "$srcdir/sdk-5.0.214/." "$pkgdir/opt/cbodotnet/5.0/"

  install -Dm755 "$srcdir/cbodotnet-5.0" "$pkgdir/usr/bin/cbodotnet-5.0"
  install -Dm644 "$srcdir/distribution.json" "$pkgdir/usr/share/doc/$pkgname/distribution.json"
  install -Dm644 "$srcdir/sdk-5.0.214/LICENSE.txt" "$pkgdir/usr/share/licenses/$pkgname/LICENSE.txt"
  install -Dm644 "$srcdir/sdk-5.0.214/ThirdPartyNotices.txt" "$pkgdir/usr/share/licenses/$pkgname/ThirdPartyNotices.txt"
}
