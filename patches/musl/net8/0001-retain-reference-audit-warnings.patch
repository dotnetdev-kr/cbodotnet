--- a/src/source-build-assets/eng/Build.props
+++ b/src/source-build-assets/eng/Build.props
@@ -1,5 +1,15 @@
 <Project>
 
+  <!-- Arcade restores the project graph through a separate NuGet.targets
+       project. Forward the engine exception to that bulk restore context;
+       /warnaserror otherwise promotes the visible reference warnings again.
+       Only referencePackages converts NuGet audit errors into warnings.
+       Literal audit errors from other projects remain fatal, and the producer
+       independently rejects every diagnostic outside the closed reference graph. -->
+  <ItemGroup>
+    <_SolutionRestoreProps Include="MSBuildWarningsNotAsErrors=$([MSBuild]::Escape('$(MSBuildWarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904'))" />
+  </ItemGroup>
+
   <ItemGroup Condition="'$(GeneratePackageSource)' == 'true'">
     <ProjectToBuild Include="$(RepoRoot)src\packageSourceGenerator\PackageSourceGenerator.proj" />
   </ItemGroup>
--- a/src/source-build-assets/src/referencePackages/Directory.Build.props
+++ b/src/source-build-assets/src/referencePackages/Directory.Build.props
@@ -26,6 +26,14 @@
     <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
     <WarningsAsErrors></WarningsAsErrors>
     <CheckEolTargetFramework>false</CheckEolTargetFramework>
+
+    <!-- Preserve historical API identities for signature-only reference packages.
+         Keep auditing and all NU190x diagnostics visible. Only this reference
+         directory downgrades audit errors; the producer independently accepts
+         the closed reviewed advisory graph and rejects runtime stub placements.
+         Every implementation and other project retains its normal audit policy. -->
+    <NuGetAudit>true</NuGetAudit>
+    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
     
     <Nullable>Disable</Nullable>
     <LangVersion>latest</LangVersion>

