--- a/src/source-build-assets/eng/SourceBuild.props
+++ b/src/source-build-assets/eng/SourceBuild.props
@@ -5,6 +5,14 @@
   <PropertyGroup>
     <GitHubRepositoryName>source-build-assets</GitHubRepositoryName>
     <SourceBuildManagedOnly>true</SourceBuildManagedOnly>
+    <!-- SDK 8 worker nodes promote these warnings despite per-project engine
+         exceptions. Scope the process policy to this component's inner build.
+         Auditing and diagnostics remain visible; referencePackages alone
+         converts NuGet audit errors to warnings. Literal errors remain fatal.
+         The producer independently requires the exact closed advisory graph
+         and rejects runtime stub placements. Commas keep the shell argument
+         a single token without command separators. -->
+    <InnerBuildArgs>$(InnerBuildArgs) /warnNotAsError:NU1901,NU1902,NU1903,NU1904</InnerBuildArgs>
   </PropertyGroup>
 
   <Target Name="TriggerBuildDependencyPackageProjects"
--- a/src/source-build-assets/src/referencePackages/Directory.Build.props
+++ b/src/source-build-assets/src/referencePackages/Directory.Build.props
@@ -26,6 +26,14 @@
     <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
     <WarningsAsErrors></WarningsAsErrors>
     <CheckEolTargetFramework>false</CheckEolTargetFramework>
+
+    <!-- Preserve historical API identities for signature-only reference packages.
+         Keep auditing and all NU190x diagnostics visible. Only this reference
+         directory downgrades audit errors; the producer independently accepts
+         the closed reviewed advisory graph and rejects runtime stub placements.
+         Every implementation and other project retains its normal audit policy. -->
+    <NuGetAudit>true</NuGetAudit>
+    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
     
     <Nullable>Disable</Nullable>
     <LangVersion>latest</LangVersion>

