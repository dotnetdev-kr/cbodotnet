Subject: [PATCH] Select the ASP.NET crossgen2 compiler for the actual SDK libc

ASP.NET maps the target OS linux-musl to linux for crossgen2's target option.
Using that same value for the compiler package selects a glibc host executable
inside native Alpine. Choose the compiler package from the actual SDK host
libc separately; keep crossgen target OS, optimization and ReadyToRun enabled.
Non-musl host package selection retains its original behavior.

Base-VMR: 7d1bf90885cff22e7da72b27e9848e42fd3cb1ae
Original-Project-Git-Blob: 43332bac4af43c8dbb6dc772f6a9b90b849722e1

--- a/src/aspnetcore/src/Framework/App.Runtime/src/Microsoft.AspNetCore.App.Runtime.csproj
+++ b/src/aspnetcore/src/Framework/App.Runtime/src/Microsoft.AspNetCore.App.Runtime.csproj
@@ -109,7 +109,11 @@
     <BuildOsName Condition=" '$(PortableBuild)' == 'false' ">$(TargetRuntimeIdentifier.Substring(0,$(TargetRuntimeIdentifier.IndexOf('-'))))</BuildOsName>
     <Crossgen2BuildArchitecture Condition=" '$(BuildOsName)' == 'win' ">x64</Crossgen2BuildArchitecture>
     <Crossgen2BuildArchitecture Condition=" '$(Crossgen2BuildArchitecture)' == '' ">$(BuildArchitecture)</Crossgen2BuildArchitecture>
-    <Crossgen2PackageRootVariableName>PkgMicrosoft_NETCore_App_Crossgen2_$(BuildOsName.Replace('.', '_'))-$(Crossgen2BuildArchitecture)</Crossgen2PackageRootVariableName>
+    <!-- Select the compiler for the actual SDK host libc, independently of
+         the crossgen target OS value, which remains linux for musl targets. -->
+    <Crossgen2HostOsName>$(BuildOsName)</Crossgen2HostOsName>
+    <Crossgen2HostOsName Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('linux-musl-'))">linux-musl</Crossgen2HostOsName>
+    <Crossgen2PackageRootVariableName>PkgMicrosoft_NETCore_App_Crossgen2_$(Crossgen2HostOsName.Replace('.', '_'))-$(Crossgen2BuildArchitecture)</Crossgen2PackageRootVariableName>
 
     <AssetTargetFallback>$(AssetTargetFallback);native,Version=0.0</AssetTargetFallback>
 
@@ -140,7 +144,7 @@
       $(GeneratePathProperty) and hacks in the _ExpandRuntimePackageRoot target work around the gaps.
     -->
     <Reference Condition="'$(CrossgenOutput)' == 'true'"
-        Include="Microsoft.NETCore.App.Crossgen2.$(BuildOsName)-$(Crossgen2BuildArchitecture)"
+        Include="Microsoft.NETCore.App.Crossgen2.$(Crossgen2HostOsName)-$(Crossgen2BuildArchitecture)"
         ExcludeAssets="All"
         PrivateAssets="All"
         GeneratePathProperty="true" />
